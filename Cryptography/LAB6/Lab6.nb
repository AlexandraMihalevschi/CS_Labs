    RowBox[{"Choose", " ", "random", " ", "k", " ", "coprime", " ", "to", " ", 
     RowBox[{"(", 
      RowBox[{"p", "-", "1"}], ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"k", "=", 
     RowBox[{"RandomInteger", "[", 
      RowBox[{"{", 
       RowBox[{"2", ",", 
        RowBox[{"p", "-", "2"}]}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"While", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"GCD", "[", 
        RowBox[{"k", ",", 
         RowBox[{"p", "-", "1"}]}], "]"}], "!=", "1"}], ",", 
      RowBox[{"k", "=", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{"{", 
         RowBox[{"2", ",", 
          RowBox[{"p", "-", "2"}]}], "}"}], "]"}]}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Ephemeral key k: \>\"", ",", 
      RowBox[{"Short", "[", 
       RowBox[{"k", ",", "3"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Compute", " ", "r"}], "=", 
     RowBox[{
      RowBox[{"g", "^", "k"}], " ", "mod", " ", "p"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"r", "=", 
     RowBox[{"PowerMod", "[", 
      RowBox[{"g", ",", "k", ",", "p"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<r = g^k mod p: \>\"", ",", 
      RowBox[{"Short", "[", 
       RowBox[{"r", ",", "3"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Compute", " ", "s"}], "=", 
     RowBox[{
      RowBox[{"k", "^", 
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}]}], "*", 
      RowBox[{"(", 
       RowBox[{"h", "-", 
        RowBox[{"x", "*", "r"}]}], ")"}], " ", "mod", " ", 
      RowBox[{"(", 
       RowBox[{"p", "-", "1"}], ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"kInv", "=", 
     RowBox[{"PowerMod", "[", 
      RowBox[{"k", ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"p", "-", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"s", "=", 
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{"kInv", "*", 
        RowBox[{"(", 
         RowBox[{"h", "-", 
          RowBox[{"x", "*", "r"}]}], ")"}]}], ",", 
       RowBox[{"p", "-", "1"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Ensure", " ", "s"}], "\[NotEqual]", 
     RowBox[{"0", " ", 
      RowBox[{"(", 
       RowBox[{"regenerate", " ", "if", " ", "needed"}], ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"While", "[", 
     RowBox[{
      RowBox[{"s", "==", "0"}], ",", 
      RowBox[{
       RowBox[{"k", "=", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{"{", 
          RowBox[{"2", ",", 
           RowBox[{"p", "-", "2"}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"GCD", "[", 
           RowBox[{"k", ",", 
            RowBox[{"p", "-", "1"}]}], "]"}], "!=", "1"}], ",", 
         RowBox[{"k", "=", 
          RowBox[{"RandomInteger", "[", 
           RowBox[{"{", 
            RowBox[{"2", ",", 
             RowBox[{"p", "-", "2"}]}], "}"}], "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"r", "=", 
        RowBox[{"PowerMod", "[", 
         RowBox[{"g", ",", "k", ",", "p"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"kInv", "=", 
        RowBox[{"PowerMod", "[", 
         RowBox[{"k", ",", 
          RowBox[{"-", "1"}], ",", 
          RowBox[{"p", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"s", "=", 
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"kInv", "*", 
           RowBox[{"(", 
            RowBox[{"h", "-", 
             RowBox[{"x", "*", "r"}]}], ")"}]}], ",", 
          RowBox[{"p", "-", "1"}]}], "]"}]}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<s = k^(-1)*(h - x*r) mod (p-1): \>\"", ",", 
      RowBox[{"Short", "[", 
       RowBox[{"s", ",", "3"}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<ElGamal Signature: (r, s)\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  r = \>\"", ",", 
      RowBox[{"Short", "[", 
       RowBox[{"r", ",", "3"}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  s = \>\"", ",", 
      RowBox[{"Short", "[", 
       RowBox[{"s", ",", "3"}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Internal", " ", 
     RowBox[{"check", ":", 
      RowBox[{
       RowBox[{"k", "*", "s"}], "\[Congruent]", 
       RowBox[{"h", "-", 
        RowBox[{"x", "*", "r", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"mod", " ", "p"}], "-", "1"}], ")"}]}]}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Internal check: k*s \[Congruent] h - x*r (mod p-1)\>\"",
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"checkLeft", "=", 
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{"k", "*", "s"}], ",", 
       RowBox[{"p", "-", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"checkRight", "=", 
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{"h", "-", 
        RowBox[{"x", "*", "r"}]}], ",", 
       RowBox[{"p", "-", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  k*s mod (p-1) = \>\"", ",", 
      RowBox[{"Short", "[", 
       RowBox[{"checkLeft", ",", "3"}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  (h - x*r) mod (p-1) = \>\"", ",", 
      RowBox[{"Short", "[", 
       RowBox[{"checkRight", ",", "3"}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Match: \>\"", ",", 
      RowBox[{"checkLeft", "==", "checkRight"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", "2.4"}]}]}]}]}], ":", 
     RowBox[{"ElGamal", " ", "Signature", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Verification", "--"}], "--"}], "--"}], "--"}], "--"}]}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<--- 2.4: ElGamal Signature Verification ---\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Verifying: g^h \[Congruent] y^r * r^s (mod p)\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Left", " ", 
     RowBox[{"side", ":", 
      RowBox[{
       RowBox[{"g", "^", "h"}], " ", "mod", " ", "p"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"leftSide", "=", 
     RowBox[{"PowerMod", "[", 
      RowBox[{"g", ",", "h", ",", "p"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Right", " ", 
     RowBox[{"side", ":", 
      RowBox[{
       RowBox[{"y", "^", "r"}], "*", 
       RowBox[{"r", "^", "s"}], " ", "mod", " ", "p"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"rightSide", "=", 
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"PowerMod", "[", 
         RowBox[{"y", ",", "r", ",", "p"}], "]"}], "*", 
        RowBox[{"PowerMod", "[", 
         RowBox[{"r", ",", "s", ",", "p"}], "]"}]}], ",", "p"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"verifiedEG", "=", 
     RowBox[{"(", 
      RowBox[{"leftSide", "==", "rightSide"}], ")"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"verifiedEG", "=", 
     RowBox[{"(", 
      RowBox[{"leftSide", "==", "rightSide"}], ")"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<ELGAMAL VERIFICATION: \>\"", ",", "verifiedEG"}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "==="}], "="}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"PRINT", " ", "SUMMARY", " ", "AND", " ", "RESULTS"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "==="}], "="}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Left side:  g^h mod p = \>\"", ",", 
      RowBox[{"Short", "[", 
       RowBox[{"leftSide", ",", "3"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Right side: y^r * r^s mod p = \>\"", ",", 
      RowBox[{"Short", "[", 
       RowBox[{"leftSide", ",", "3"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rightSide", " ", "=", " ", "leftSide"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"verifiedEG", "=", 
     RowBox[{"(", 
