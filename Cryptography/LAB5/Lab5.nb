   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "n", " ", "and", " ", "phi", 
     RowBox[{"(", "n", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", 
     RowBox[{"p", "*", "q"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"phi", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", "-", "1"}], ")"}], "*", 
