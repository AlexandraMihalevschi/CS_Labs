   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Derive", " ", "AES"}], "-", 
     RowBox[{"256", " ", "key", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"256", " ", "bits"}], "=", 
        RowBox[{"32", " ", "bytes"}]}], ")"}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Use", " ", "SHA"}], "-", 
     RowBox[{
     "256", " ", "hash", " ", "of", " ", "the", " ", "shared", " ", 
      "secret"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sharedSecretBytes", "=", 
     RowBox[{"IntegerDigits", "[", 
      RowBox[{"aliceShared", ",", "256"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"aes256Key", "=", 
     RowBox[{"Hash", "[", 
      RowBox[{"sharedSecretBytes", ",", "\"\<SHA256\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<AES-256 Key (SHA-256 hash): \>\"", ",", "aes256Key"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<AES-256 Key bit length: \>\"", ",", 
      RowBox[{
       RowBox[{"ByteCount", "[", "aes256Key", "]"}], "*", "8"}], 
      ",", "\"\< bits\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Alternative", ":", 
     RowBox[{
     "Extract", " ", "first", " ", "256", " ", "bits", " ", "directly"}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"sharedSecretBinary", "=", 
     RowBox[{"IntegerString", "[", 
      RowBox[{"aliceShared", ",", "2"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"aes256KeyBits", "=", 
     RowBox[{"StringTake", "[", 
      RowBox[{"sharedSecretBinary", ",", 
       RowBox[{"UpTo", "[", "256", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Pad", " ", "if", " ", "necessary"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"StringLength", "[", "aes256KeyBits", "]"}], "<", "256"}], ",", 
      RowBox[{"aes256KeyBits", "=", 
       RowBox[{"StringPadLeft", "[", 
        RowBox[{"aes256KeyBits", ",", "256", ",", "\"\<0\>\""}], "]"}]}]}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"aes256KeyHex", "=", 
     RowBox[{"IntegerString", "[", 
      RowBox[{
       RowBox[{"FromDigits", "[", 
        RowBox[{"aes256KeyBits", ",", "2"}], "]"}], ",", "16", ",", "64"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<AES-256 Key (first 256 bits of shared secret): \>\"", ",", 
      "aes256KeyHex"}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n========== TASK COMPLETED ==========\>\"", "]"}], 
    ";"}]}]}]], "Input",
